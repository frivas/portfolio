{
  "name": "portfolio",
  "private": true,
  "description": "Static sites behind portfolio.probablysmart.com. Dev-only tools for CI; nothing here ships.",
  "type": "module",
  "scripts": {
    "lint:html": "html-validate \"sites/**/*.html\"",
    "lint:css": "stylelint \"sites/**/*.css\" \"sites/**/*.html\"",
    "lint:js": "eslint .",
    "typecheck": "tsc -p .",
    "check": "npm run lint:html && npm run lint:css && npm run lint:js && npm run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "html-validate": "^11.21.1",
    "postcss-html": "^2.0.1",
    "stylelint": "^18.0.0",
    "stylelint-config-recommended": "^19.0.0",
    "typescript": "^7.0.2"
  }
}
